# --- Django -----------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Add your tunnel host while testing webhooks, e.g. .trycloudflare.com or .ngrok-free.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# --- Database (sqlite for the POC; postgres for production) ------------------
DB_ENGINE=sqlite
POSTGRES_DB=ushika
POSTGRES_USER=ushika
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Meta WhatsApp Cloud API -------------------------------------------------
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# From App settings > Basic > App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string you choose; paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# Graph API version, e.g. v25.0 (match the sample request on the API Setup page)
WHATSAPP_API_VERSION=v25.0
WHATSAPP_REQUEST_TIMEOUT=20

# --- Media downloads ---------------------------------------------------------
# false: files are saved on request (POST /api/v1/attachments/{id}/save/), subject to the contact's level
WHATSAPP_DOWNLOAD_MEDIA=false
WHATSAPP_MEDIA_TYPES=image,document,audio,video,sticker
WHATSAPP_MEDIA_MAX_BYTES=104857600
WHATSAPP_MEDIA_MAX_ATTEMPTS=5
# MEDIA_ROOT=./storage

# --- Background processing (optional) ----------------------------------------
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0

WHATSAPP_LOG_LEVEL=INFO
